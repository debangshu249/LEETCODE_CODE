class Solution {
  public:
  
    bool fun(vector<int> &stall,int n,int k,int guess){
        int cow = 1;
        int position = stall[0];  // cow1 placed
        for(int i=0;i<n;i++){
            int dist = stall[i] - position;
            if(dist < guess )
            continue;
            else {
            cow++;
            position = stall[i];    
            }
        }
        if(cow >= k)  // k er saman ba k er theke besi cow rakhte parle hobe
        return true;
        else 
        return false;
    }
    
    int aggressiveCows(vector<int> &stall, int k) { // k=3(ex)
        int n = stall.size();
        sort(stall.begin(),stall.end());
        int low = 1; //MIN distance b/t two cow
        int high = stall[n-1] - stall[0]; //MAX distance b/t two cow
        int res = -1;
        
        while(low <= high){
            int guess = low + (high - low) / 2;
            // Now Function calls
            if(fun(stall,n,k,guess)){
                res = guess;
                low = guess + 1;
            }
            else
            high = guess - 1;
        }
        return res;
    }
};
